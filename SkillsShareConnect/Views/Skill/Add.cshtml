@model SkillsShareConnect.Models.ViewModels.SkillRequest
@{
    ViewBag.Title = "Skill";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Place Autocomplete Address Form</title>
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,500" rel="stylesheet" />
    <link rel="stylesheet" href="~/LandingPage/assets/css/main.css" />
    <link rel="stylesheet" type="text/css" href="~/css/AddressStyleSheet.css" />
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBICQAKKC-3ojHLUw8LIdVNVbcJFNAR9-I&libraries=places" defer></script>
</head>
<body>
    <div class="bg-opacity-10 py-2">
        <div class="container mb-3">
            <h1 class="text-center">Add a Skill</h1>
        </div>
    </div>

    <div class="py-2">
        <form method="post">
            <div class="mb-3">
                <label class="form-label" for="Name">Skill Name</label>
                <input type="text" class="form-control" id="name" asp-for="Name" placeholder="Enter the skill name" required>
            </div>

            <div class="mb-3">
                <label class="form-label" for="ShortDescription">Short Description</label>
                <textarea class="form-control" id="shortDescription" asp-for="ShortDescription" placeholder="Enter a short description"></textarea>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>

</body>
</html>
