@model List<SkillsShareConnect.Models.Address>
@{
    ViewBag.Title = "Addresses";
}
<div class="bg-opacity-10 py-2">
    <div class="container mb-3">
        <h1 class="text-center">Addresses</h1>
    </div>
</div>

<div class="py-3">
    @if (Model != null && Model.Any())
    {
        <p class="text-center py-5">Here are the addresses you have added:</p>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Location</th>
                    <th>Apartment</th>
                    <th>City</th>
                    <th>Province</th>
                    <th>Postal Code</th>
                    <th>Country</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var address in Model)
                {
                    <tr>
                        <td>@address.Location</td>
                        <td>@address.Apartment</td>
                        <td>@address.City</td>
                        <td>@address.Province</td>
                        <td>@address.PostalCode</td>
                        <td>@address.Country</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-center">You have not added any addresses yet.</p>
    }
</div>

<a asp-action="Add" class="btn btn-primary">Add New Address</a>
